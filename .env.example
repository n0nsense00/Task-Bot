TELEGRAM_BOT_TOKEN=your_token_here
MY_TELEGRAM_ID=your_numeric_id_here

# Optional - numeric Telegram chat ID of the group the bot is restricted to.
# Updates from any other chat (DMs, other groups) are dropped silently.
# Group IDs are negative; supergroups start with -100...
#
# Leave unset (or set to 0) while discovering the group id. The owner can still
# use the bot anywhere, while other users are rejected. Steps:
#   1. Deploy with ALLOWED_CHAT_ID unset (or =0).
#   2. Add the bot to the target group; send /start as the owner.
#   3. Read the "/start received: chat_id=..." line in the logs.
#   4. Paste that chat_id here and restart the bot.
# ALLOWED_CHAT_ID=-1001234567890

# Optional - IANA timezone used for the daily 08:00 brief.
# Defaults to Asia/Singapore if unset. Use any valid IANA name.
# TIMEZONE=Asia/Singapore

# Optional - enables the automatic daily morning brief. /brief works either way.
# MORNING_BRIEF_ENABLED=false

# Optional - override the SQLite path for isolated local runs/tests.
# TASK_BOT_DB_PATH=data/tasks.db
