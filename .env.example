TELEGRAM_BOT_TOKEN=your_token_here
MY_TELEGRAM_ID=your_numeric_id_here

# Optional - IANA timezone used for the daily 08:00 brief.
# Defaults to Asia/Singapore if unset. Use any valid IANA name.
# TIMEZONE=Asia/Singapore

# Optional - enables the automatic daily morning brief. /brief works either way.
# MORNING_BRIEF_ENABLED=false

# Optional - override the SQLite path for isolated local runs/tests.
# TASK_BOT_DB_PATH=data/tasks.db
